{
  "name": "xui-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter showcase dev",
    "typecheck": "pnpm -r run typecheck && pnpm run typecheck:e2e",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "test:unit": "vitest run",
    "verify": "playwright test",
    "verify:parity": "playwright test e2e/parity.spec.ts",
    "verify:preflight": "playwright test e2e/preflight.spec.ts"
  },
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.3",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
